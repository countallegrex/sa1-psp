-/* USB thread to handle attach/detach */
+/* (Re)queue the async request for the new session.  One left queued from the previous
+   session (a host that died, no detach) is cancelled first: a request is queued once. */
+static void rearm_async(void)
+{
+	if(g_async_armed)
+	{
+		sceUsbbdReqCancelAll(&endp[3]);
+		sceKernelDelayThread(10*1000);
+	}
+	set_ayncreq(async_data, sizeof(async_data));
+}
+
+/* Wait a moment for a host's hello on the bulk out endpoint, and answer it.  Polled, so
+   the USB thread keeps serving detach and async events while no host is there. */
+static void try_handshake(void)
+{
+	uint32_t magic;
+	SceUInt t = USB_MAGIC_POLL;
+	int ret;
+
+	/* a caller whose transfer just timed out may still hold the bus */
+	if(sceKernelWaitSema(g_mainsema, 1, &t) < 0)
+	{
+		return;
+	}
+	ret = read_data_ex(&magic, sizeof(magic), USB_MAGIC_POLL, 0);
+	(void) sceKernelSignalSema(g_mainsema, 1);
+
+	if((ret == sizeof(magic)) && (magic == HOSTFS_MAGIC))
+	{
+		if(send_hello_cmd())
+		{
+			rearm_async();
+			g_wantmagic = 0;
+			g_connected = 1;
+			sceKernelSetEventFlag(g_mainevent, USB_EVENT_CONNECT);
+			MODPRINTF("USB host connected\n");
+		}
+	}
+}
