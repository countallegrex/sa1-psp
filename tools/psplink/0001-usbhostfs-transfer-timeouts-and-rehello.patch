+/* Wait for a bulk transfer to complete.  timeout 0 waits forever.  On a timeout the request
+   is cancelled (its buffer is ours again once the cancel completes) and, if lost is set, the
+   link is dropped. */
+static int wait_xfer(struct UsbdDeviceReq *req, u32 bit, SceUInt timeout, int lost)
+{
+	u32 result;
+	SceUInt t = timeout;
+	int ret;
+
+	ret = sceKernelWaitEventFlag(g_transevent, bit, PSP_EVENT_WAITOR | PSP_EVENT_WAITCLEAR, &result, timeout ? &t : NULL);
+	if(ret == (int) SCE_KERNEL_ERROR_WAIT_TIMEOUT)
+	{
+		t = 200*1000;
+		sceUsbbdReqCancelAll(req->endp);
+		/* the cancelled request completes through its callback */
+		sceKernelWaitEventFlag(g_transevent, bit, PSP_EVENT_WAITOR | PSP_EVENT_WAITCLEAR, &result, &t);
+		if(lost)
+		{
+			link_lost();
+		}
+	}
+
+	return ret;
+}
