+/* Take the bus.  Unless force is set (the hello), give up once the link is down: a caller
+   that queued behind a transfer that then timed out must not talk to the next host. */
+static int lock_bus(int force)
+{
+	SceUInt t = USB_SEMA_TIMEOUT;
+	int err;
+
+	if(!force && !g_connected)
+	{
+		return -1;
+	}
+
+	err = sceKernelWaitSema(g_mainsema, 1, &t);
+	if(err < 0)
+	{
+		MODPRINTF("Error waiting on xchg semaphore %08X\n", err);
+		return err;
+	}
+
+	if(!force && !g_connected)
+	{
+		(void) sceKernelSignalSema(g_mainsema, 1);
+		return -1;
+	}
+
+	return 0;
+}
