+/* The host is gone: stop claiming a connection, so callers fail at once instead of queueing
+   on g_mainsema, and let the USB thread wait for the next host's hello. */
+static void link_lost(void)
+{
+	if(g_connected)
+	{
+		MODPRINTF("USB host stopped answering: link dropped\n");
+	}
+	g_connected = 0;
+	sceKernelClearEventFlag(g_mainevent, ~USB_EVENT_CONNECT);
+	sceKernelSetEventFlag(g_mainevent, USB_EVENT_LOST);
+}
