+/* Send to a client socket.  A client that went away must not take the host with it: no
+   SIGPIPE, and the socket cannot be closed (and its number reused) while we write. */
+static void client_send(unsigned int chan, const void *data, int len)
+{
+	int sent = 0;
+
+	pthread_mutex_lock(&g_sockmtx);
+	while((sent < len) && (g_clientsocks[chan] >= 0))
+	{
+		int ret = send(g_clientsocks[chan], (const char *) data + sent, len - sent, MSG_NOSIGNAL);
+		if(ret <= 0)
+		{
+			if((ret < 0) && (errno == EINTR))
+			{
+				continue;
+			}
+			break;
+		}
+		sent += ret;
+	}
+	pthread_mutex_unlock(&g_sockmtx);
+}
