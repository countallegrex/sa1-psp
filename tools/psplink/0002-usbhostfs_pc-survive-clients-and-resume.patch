+/* Send the hello magic.  Returns 1 when the PSP is ours to serve. */
+static int hostfs_handshake(libusb_device_handle *h)
+{
+	uint32_t magic = LE32(HOSTFS_MAGIC);
+	int i;
+	int ret;
+
+	ret = euid_usb_bulk_write(h, 0x2, (char *) &magic, sizeof(magic), 1000);
+	if(ret == sizeof(magic))
+	{
+		return 1;
+	}
+	if(ret != LIBUSB_ERROR_TIMEOUT)
+	{
+		return 0;
+	}
+
+	/* The PSP did not take the hello: it is past its attach handshake because the previous
+	   host died while connected (killed with the cable in, so no detach, and on Windows the
+	   PSP cannot be made to re-enumerate).  Announce ourselves on the async endpoint, which a
+	   connected PSP always reads: a patched usbhostfs.prx drops the old session and waits
+	   for the hello again; a stock one ignores 4 bytes there. */
+	fprintf(stderr, "PSP did not take the hello: announcing on the async endpoint\n");
+	pthread_mutex_lock(&g_usbmtx);
+	euid_usb_bulk_write(h, 0x3, (char *) &magic, sizeof(magic), 1000);
+	pthread_mutex_unlock(&g_usbmtx);
+	for(i = 0; i < 3; i++)
+	{
+		ret = euid_usb_bulk_write(h, 0x2, (char *) &magic, sizeof(magic), 1000);
+		if(ret == sizeof(magic))
+		{
+			return 1;
+		}
+		if(ret != LIBUSB_ERROR_TIMEOUT)
+		{
+			return 0;
+		}
+	}
+
+	/* A stock usbhostfs.prx: serve its previous session as it stands.  Draining the bulk in
+	   endpoint frees a PSP thread stuck sending stdout, and its next commands work as they
+	   did with the old host. */
+	fprintf(stderr, "Resuming the PSP's previous session\n");
+	return 1;
+}
